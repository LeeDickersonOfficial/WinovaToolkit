{
  "name": "winova-toolkit",
  "version": "0.1.20",
  "description": "A polished Windows utility toolkit built with Electron.",
  "main": "src/main.js",
  "author": "Winova",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.winova.toolkit",
    "productName": "Winova Toolkit",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "publish": [{ "provider": "github", "owner": "LeeDickersonOfficial", "repo": "WinovaToolkit", "releaseType": "release" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "Winova-Toolkit-Setup-${version}-${arch}.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "portable": { "artifactName": "Winova-Toolkit-Portable-${version}-${arch}.${ext}" }
  }
}
